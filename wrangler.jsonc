{
  "name": "wenxu-document-agent",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wenxu-documents",
      "database_id": "38508b06-3d27-42ee-b2e5-55cfc7d566fb",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "LOCAL_DEV": "false",
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
  }
}
